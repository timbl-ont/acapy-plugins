<div>
  <div hx-ext="sse" sse-connect="/stream/present/<%= presentationId %>" class="w3-row">
      <div class="w3-container w3-center">
        <div sse-swap="status" id="presentation"></div>
        <p class="w3-text-gray" style="margin-bottom: 1em;">
          Requests the demo SD-JWT VC (<code>ExampleIDCard</code>) through the
          W3C Digital Credentials API instead of a QR code. Needs a browser and
          wallet that support OpenID4VP over <code>navigator.credentials.get</code>,
          and the page must be served from https or localhost.
        </p>
        <button
            class="w3-btn w3-green"
            onclick="requestViaDcApi('<%= presentationId %>')"
            id="pres-create"
            >
          Request via DC-API
        </button>
    </div>
    <div style="display:flex; flex-direction: column;" class="w3-col m12 l12">
      <pre style="flex-grow: 1; text-wrap: pretty; padding-bottom: 15px; overflow-wrap: anywhere;">
      <div sse-swap="message" hx-swap="beforeend"></div>
      <div sse-swap="debug" hx-swap="beforeend"></div>
      </pre>
    </div>
  </div>
</div>
<div id="navigation" hx-swap-oob="innerhtml">
  <%- include('navigation.ejs') %>
</div>
<div id="content-header" hx-swap-oob="innerhtml">
  <h1 class="w3-jumbo"><b>OpenID4VP</b></h1>
  <h1 class="w3-xxxlarge w3-text-green"><b>Present via DC-API</b></h1>
  <hr style="width:50px;border:5px solid green" class="w3-round">
</div>
