NGROK_AUTHTOKEN=your-ngrok-authtoken
ADMIN_MANAGE_AUTH_TOKEN=adminsecrettoken
ADMIN_INTERNAL_AUTH_TOKEN=admininternaltoken # match TENANT_INTERNAL_AUTH_TOKEN
TENANT_INTERNAL_AUTH_TOKEN=admininternaltoken # match ADMIN_INTERNAL_AUTH_TOKEN
#Optional if you have a static AuthServer URL e.g. https://auth.yourdomain.com
#AUTHSERVER_NGROK_URL= 
# Keycloak as the authorization server (docker-compose.keycloak.yaml)
#KEYCLOAK_ADMIN_USERNAME=admin
#KEYCLOAK_ADMIN_PASSWORD=admin
# Wallet attestation (ABCA) is off by default. To require it:
#KEYCLOAK_REQUIRE_ATTESTATION=true
#KEYCLOAK_WALLET_CLIENT_ID=your-wallet-client-id
# The wallet provider's attester public keys: a JWKS (JSON, one line) or a JWKS URL
#KEYCLOAK_ATTESTER_JWKS={"keys":[...]}
#KEYCLOAK_ATTESTER_JWKS_URL=https://wallet-provider.example/attester/jwks.json
#KEYCLOAK_REQUIRE_DPOP=true
# Refresh token lifetime in seconds (default 1 year)
#KEYCLOAK_REFRESH_TOKEN_LIFESPAN=31536000
#Optional if you have a static Keycloak URL
#KEYCLOAK_NGROK_URL=
